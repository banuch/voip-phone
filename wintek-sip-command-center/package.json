{
  "name": "wintek-sip-command-center",
  "private": true,
  "version": "1.1.0",
  "description": "Wintek ATM SIP Command Center - operator-initiated SIP intercom management for ATM fleets",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev:api": "pnpm --filter @wintek/api dev",
    "dev:dashboard": "pnpm --filter @wintek/dashboard dev",
    "db:migrate": "pnpm --filter @wintek/api db:migrate",
    "db:seed": "pnpm --filter @wintek/api db:seed"
  }
}
