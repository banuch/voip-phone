# Copy to infra/.env and fill in. Generate secrets with: openssl rand -base64 48
NODE_ENV=production
POSTGRES_PASSWORD=
JWT_SECRET=
INTERNAL_WEBHOOK_SECRET=
ARI_PASSWORD=
ASTERISK_DB_PASSWORD=
TURN_SECRET=
COOKIE_SECURE=true
CORS_ORIGINS=https://command.example.com
